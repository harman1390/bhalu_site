RewriteEngine On

# Never serve secrets, logs or one-shot scripts over HTTP.
<FilesMatch "^(config\.php|migrate\.php|cleanup-descriptions\.php|README\.md|.*\.(log|sql|bak|old|swp))$">
	Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?p=$1 [QSA,L]
